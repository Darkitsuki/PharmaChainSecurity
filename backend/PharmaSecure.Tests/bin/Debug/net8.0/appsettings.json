{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PharmaSecure": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost:1521/FREEPDB1;User Id=${DB_USER};Password=${DB_PASSWORD};"
  },
  "Jwt": {
    "Issuer": "PharmaSecure.AuthService",
    "Audience": "PharmaSecure.Clients",
    "SecretKey": "${JWT_SECRET}",
    "ExpiryMinutes": 60
  },
  "DigitalSignature": {
    "PrivateKeyPkcs8Base64": "${PHARMA_SIGNING_PRIVATE_KEY}",
    "CertificateSerial": "${PHARMA_CERT_SERIAL}"
  }
}
