{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PharmaSecure": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PharmaSecureDb;User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "PharmaSecure.AuthService",
    "Audience": "PharmaSecure.Clients",
    "ExpiryMinutes": 60
  }
}
