{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PharmaSecure": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=${ORACLE_DATA_SOURCE};User Id=${ORACLE_USER};Password=${ORACLE_PASSWORD};"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Jwt": {
    "Issuer": "PharmaSecure.AuthService",
    "Audience": "PharmaSecure.Clients",
    "SecretKey": "${JWT_SECRET}",
    "ExpiryMinutes": 60
  },
  "DigitalSignature": {
    "PrivateKeyPkcs8Base64": "${PHARMA_SIGNING_PRIVATE_KEY}",
    "CertificateSerial": "VN-LONGCHAU-CA-2026-0001"
  }
}