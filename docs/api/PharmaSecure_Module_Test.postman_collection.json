          "mode": "raw",
          "raw": "{\n  \"drugCode\": \"THUOC_TEST_01\",\n  \"name\": \"Vitamin C 1000mg Tuýp Sủi\",\n  \"activeIngredient\": \"Acid Ascorbic\",\n  \"unit\": \"Tuýp\",\n  \"price\": 65000\n}"
