        "body": {
          "mode": "raw",
          "raw": "{\n  \"supplierCode\": \"NCC_TEST_01\",\n  \"supplierName\": \"Công ty Dược Liệu Trung Ương\",\n  \"contactPerson\": \"Trần Văn A\",\n  \"phoneNumber\": \"0987654321\",\n  \"email\": \"contact@duoclieu.vn\",\n  \"address\": \"Hà Nội\",\n  \"taxCode\": \"0101234567\"\n}"
        },
        "url": {
