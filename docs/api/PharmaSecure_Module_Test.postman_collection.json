          "raw": "{\n  \"supplierId\": \"sup-00000000-0000-0000-0000-000000000001\",\n  \"note\": \"Nhập hàng đợt 1 tháng 10/2026\",\n  \"items\": [\n    {\n      \"drugId\": \"dr-00000000-0000-0000-0000-000000000001\",\n      \"batchNo\": \"BATCH-202610-01\",\n      \"expiryDate\": \"2028-10-01\",\n      \"mfgDate\": \"2026-10-01\",\n      \"quantity\": 100,\n      \"importPrice\": 25000\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/goods-receipts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "goods-receipts"]
        }
      }
    },
