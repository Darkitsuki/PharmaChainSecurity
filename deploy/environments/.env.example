# PharmaSecure Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN ACTUAL SECURE CREDENTIALS.
# NEVER COMMIT .env TO SOURCE CONTROL.

# Oracle Database Configuration
DB_USER=pharmasecure_app
DB_PASSWORD=YourAppPasswordHere123

# JWT Authentication Configuration
JWT_ISSUER=PharmaSecure.AuthService
JWT_AUDIENCE=PharmaSecure.Clients
JWT_SECRET=ReplaceWithAStrongSecretKeyOfAtLeast32BytesLength!

# Environment
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
