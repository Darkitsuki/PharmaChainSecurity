# =============================================================================
# PharmaChainSecurity - Environment Configuration Template
# Sao chép tệp này thành .env hoặc nạp qua dotnet user-secrets / biến môi trường
# =============================================================================

# 1. Oracle Database Connection
ORACLE_DATA_SOURCE=192.168.1.30:1521/FREEPDB1
ORACLE_USER=PHARMA_ADMIN
ORACLE_PASSWORD=admin123

# 2. JWT Authentication Secrets (Tối thiểu 256 bits / 32 ký tự)
JWT_SECRET=DEV_ONLY_PHARMASECURE_JWT_SIGNING_KEY_2026_DO_NOT_DEPLOY

# 3. Digital Signature (HSM / RSA 2048-bit PKCS#8 Base64)
# Để trống để sử dụng khóa tạm thời trong môi trường phát triển (Development)
PHARMA_SIGNING_PRIVATE_KEY=
PHARMA_CERT_SERIAL=VN-LONGCHAU-CA-2026-0001

